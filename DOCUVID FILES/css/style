form {
  max-width: 500px;
}

input, textarea, button {
  width: 100%;
  padding: 10px;
  margin: 10px 0;
}

button {
  background: #1f6fa8;
  color: white;
  border: none;
  cursor: pointer;
}

.video-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
}

iframe {
  width: 100%;
  height: 200px;
}
